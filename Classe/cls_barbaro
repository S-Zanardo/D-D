  "features_details": {
    "feat_rage": {
      "name": "Ira",
      "description": "Nel tuo turno, puoi entrare in ira come azione bonus. Finché sei in ira, ottieni vantaggio alle prove e ai tiri salvezza su Forza, un bonus ai danni in mischia con armi basate sulla Forza, e resistenza ai danni contundenti, perforanti e taglienti.",
      "mechanics": {
        "action_type": "bonus_action",
        "duration_minutes": 1,
        "modifiers": [
          {"type": "advantage", "target": "str_saving_throws"},
          {"type": "advantage", "target": "str_checks"},
          {"type": "damage_bonus", "target": "str_melee_attacks", "value_source": "class_specific.rage_damage"},
          {"type": "resistance", "target": ["bludgeoning", "piercing", "slashing"]}
        ],
        "restrictions": ["no_heavy_armor", "no_spellcasting"]
      }
    },
    "feat_unarmored_defense": {
      "name": "Difesa Senza Armatura",
      "description": "Finché non indossi alcuna armatura, la tua Classe Armatura è pari a 10 + Modificatore di Destrezza + Modificatore di Costituzione.",
      "mechanics": {
        "ac_formula": "10 + DEX_MOD + CON_MOD",
        "allows_shield": true
      }
    },
    "feat_reckless_attack": {
      "name": "Attacco Irruente",
      "description": "Quando effettui il primo attacco nel tuo turno, puoi decidere di attaccare in modo irruente. Farlo ti conferisce vantaggio ai tiri per colpire in mischia basati sulla Forza in questo turno, ma i tiri per colpire contro di te hanno vantaggio fino al tuo turno successivo.",
      "mechanics": {
        "action_type": "free_action",
        "modifiers": [
          {"type": "advantage", "target": "str_melee_attacks"},
          {"type": "grant_advantage", "target": "attacks_against_self", "duration": "until_next_turn"}
        ]
      }
    },
    "feat_danger_sense": {
      "name": "Percezione del Pericolo",
      "description": "Hai vantaggio ai tiri salvezza su Destrezza contro gli effetti che puoi vedere, come trappole e incantesimi. Per ottenere questo beneficio non devi essere accecato, assordato o incapacitato.",
      "mechanics": {
        "modifiers": [
          {"type": "advantage", "target": "dex_saving_throws_seen"}
        ],
        "restrictions": ["not_blinded", "not_deafened", "not_incapacitated"]
      }
    },
    "feat_primal_path": {
      "name": "Cammino Primordiale",
      "description": "Scegli un cammino che plasma la natura della tua ira. La scelta garantisce privilegi aggiuntivi a livelli specifici.",
      "mechanics": {
        "trigger": "unlock_subclass_features"
      }
    },
    "feat_extra_attack": {
      "name": "Attacco Extra",
      "description": "Puoi attaccare due volte, anziché una volta, ogni volta che effettui l'azione di Attacco nel tuo turno.",
      "mechanics": {
        "attacks_per_action": 2
      }
    },
    "feat_fast_movement": {
      "name": "Movimento Veloce",
      "description": "La tua velocità aumenta di 3 metri purché tu non indossi un'armatura pesante.",
      "mechanics": {
        "speed_bonus_meters": 3,
        "restrictions": ["no_heavy_armor"]
      }
    },
    "feat_feral_instinct": {
      "name": "Istinto Selvaggio",
      "description": "I tuoi istinti sono così affinati che hai vantaggio ai tiri per l'iniziativa. Inoltre, se sei sorpreso all'inizio del combattimento e non sei incapacitato, puoi agire normalmente nel tuo primo turno, ma solo se entri in ira prima di fare qualsiasi altra cosa in quel turno.",
      "mechanics": {
        "modifiers": [
          {"type": "advantage", "target": "initiative"}
        ],
        "special": "surprise_override_with_rage"
      }
    },
    "feat_brutal_critical_1": {
      "name": "Critico Brutale (1 dado)",
      "description": "Puoi tirare un dado di danno dell'arma aggiuntivo quando determini il danno extra per un colpo critico con un attacco in mischia.",
      "mechanics": {
        "extra_crit_dice": 1
      }
    },
    "feat_relentless_rage": {
      "name": "Ira Implacabile",
      "description": "Se scendi a 0 punti ferita mentre sei in ira e non muori sul colpo, puoi effettuare un tiro salvezza su Costituzione con CD 10. Se lo superi, scendi invece a 1 punto ferita. Ogni volta successiva che usi questo privilegio, la CD aumenta di 5.",
      "mechanics": {
        "trigger": "on_zero_hp_in_rage",
        "save": "CON",
        "base_dc": 10,
        "dc_increment": 5,
        "reset": "short_or_long_rest"
      }
    },
    "feat_brutal_critical_2": {
      "name": "Critico Brutale (2 dadi)",
      "description": "Puoi tirare due dadi di danno dell'arma aggiuntivi quando determini il danno extra per un colpo critico con un attacco in mischia.",
      "mechanics": {
        "extra_crit_dice": 2
      }
    },
    "feat_persistent_rage": {
      "name": "Ira Persistente",
      "description": "La tua ira è così feroce che termina prematuramente solo se cadi privo di sensi o se scegli di farla terminare.",
      "mechanics": {
        "end_conditions": ["unconscious", "voluntary_end"]
      }
    },
    "feat_brutal_critical_3": {
      "name": "Critico Brutale (3 dadi)",
      "description": "Puoi tirare tre dadi di danno dell'arma aggiuntivi quando determini il danno extra per un colpo critico con un attacco in mischia.",
      "mechanics": {
        "extra_crit_dice": 3
      }
    },
    "feat_indomitable_might": {
      "name": "Potenza Indomita",
      "description": "Se il totale di una prova di Forza è inferiore al tuo punteggio di Forza, puoi usare quel punteggio al posto del totale.",
      "mechanics": {
        "min_roll_override": "STR_score",
        "target": "str_checks"
      }
    },
    "feat_primal_champion": {
      "name": "Campione Primitivo",
      "description": "I tuoi punteggi di Forza e Costituzione aumentano di 4. Il tuo massimo per questi punteggi diventa 24.",
      "mechanics": {
        "stat_bonus": {"STR": 4, "CON": 4},
        "max_limit_override": 24
      }
    }
  }
}
